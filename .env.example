# Remote model configuration. Never commit a real API key.
NOYRA_MODEL_PROVIDER=openai_compatible
NOYRA_MODEL_BASE_URL=https://api.example.com/v1
NOYRA_MODEL_NAME=replace-with-model-name
NOYRA_MODEL_API_KEY=

# Resource limits are enforced outside the model.
NOYRA_DAILY_INPUT_TOKENS=100000
NOYRA_DAILY_OUTPUT_TOKENS=20000
NOYRA_DAILY_MODEL_CALLS=100
NOYRA_DAILY_COST_LIMIT=5.00
NOYRA_MODEL_INPUT_USD_PER_MILLION=0.00
NOYRA_MODEL_OUTPUT_USD_PER_MILLION=0.00
NOYRA_MODEL_MAX_ATTEMPTS=3
NOYRA_MODEL_RETRY_BASE_SECONDS=0.5
NOYRA_MODEL_RETRY_MAX_SECONDS=8

# Independent embedding resource. Leave all fields empty to use FTS/entity/
# temporal/causal retrieval without remote embeddings.
NOYRA_EMBEDDING_BASE_URL=
NOYRA_EMBEDDING_MODEL=
NOYRA_EMBEDDING_API_KEY=
NOYRA_EMBEDDING_DIMENSIONS=
NOYRA_EMBEDDING_TIMEOUT_SECONDS=30

# M24 isolated cognition pools. Each JSON array may contain multiple providers;
# each group may contain multiple API keys. Secrets are written to the runtime
# secret directory and are never stored in SQLite or exports.
NOYRA_ECONOMY_MODEL_GROUPS_JSON=[]
NOYRA_DEEP_MODEL_GROUPS_JSON=[]

# Autonomous cognition is opt-in because enabling it spends remote model quota.
NOYRA_COGNITION_ENABLED=false
# Research preview: keep economic side effects disabled. These settings do not
# remove existing grants/orders from a reused database; use a fresh data root.
NOYRA_WALLET_AUTOMATION_ENABLED=false
NOYRA_WALLET_AUTOMATION_AUTO_PUBLISH=false
NOYRA_WALLET_SIGNER_ENDPOINT=
NOYRA_WALLET_SIGNER_ID=
NOYRA_WALLET_SIGNER_BEARER_TOKEN=
NOYRA_WORLD_SOURCES_JSON=[]
NOYRA_SOURCE_REFRESH_SECONDS=900
NOYRA_WORLD_READS_PER_HOUR=24
# Allow safe, audited reads from public HTTPS sources. Set false to restrict
# the managed web-read grant to the configured world-source hosts.
NOYRA_WEB_READ_PUBLIC_BY_DEFAULT=true
NOYRA_COGNITION_MAX_OBSERVATION_CHARS=50000
NOYRA_COGNITION_MAX_OUTPUT_TOKENS=2500
NOYRA_COGNITION_TEMPERATURE=0.2
NOYRA_COGNITION_MAX_MODEL_CALLS_PER_OBSERVATION=3
NOYRA_MINIMUM_GENESIS_CYCLES=7
NOYRA_GENESIS_SLEEP_SECONDS=3600

# Human messages are considered as bounded communication invitations, not tasks.
NOYRA_INTERACTION_COOLDOWN_SECONDS=300
NOYRA_MAX_INTERACTION_MODEL_CALLS_PER_DAY=3

# Reflective sleep uses the same remote model behind a separate per-sleep bound.
NOYRA_MAX_SLEEP_MODEL_CALLS_PER_RUN=3
NOYRA_MAX_SLEEP_CONTEXT_CHARS=60000

# Awake goal governance selects an internal focus but does not execute actions.
NOYRA_GOAL_GOVERNANCE_INTERVAL_SECONDS=3600
NOYRA_MAX_GOAL_GOVERNANCE_MODEL_CALLS_PER_DAY=4
NOYRA_MAX_GOAL_GOVERNANCE_CONTEXT_CHARS=40000
NOYRA_MAX_ACTIVE_GOALS=3

# Bounded autonomous actions currently allow one authorized read-only public investigation.
NOYRA_ACTION_DELIBERATION_INTERVAL_SECONDS=3600
NOYRA_MAX_ACTION_DELIBERATION_MODEL_CALLS_PER_DAY=4
NOYRA_MAX_ACTION_DELIBERATION_CONTEXT_CHARS=24000
NOYRA_MAX_WEB_ACTIONS_PER_GOAL_PER_DAY=3

# Autonomous research chooses among configured search APIs, model discovery and browser fallback.
# Search API keys are configured at runtime through the authenticated configuration panel.
NOYRA_RESEARCH_INTERVAL_SECONDS=7200
NOYRA_MAX_RESEARCH_MODEL_CALLS_PER_DAY=6
NOYRA_MAX_RESEARCH_CONTEXT_CHARS=36000
NOYRA_MAX_SEARCH_ROUNDS_PER_RUN=2
NOYRA_MAX_SEARCH_RESULTS_PER_ROUND=8
NOYRA_MAX_DISCOVERED_SOURCES_PER_RUN=4
NOYRA_MAX_BROWSER_SEARCHES_PER_HOUR=12

# Verified outcomes update strategy confidence and may advance a goal only by a bounded amount.
NOYRA_OUTCOME_EVALUATION_INTERVAL_SECONDS=60
NOYRA_MAX_GOAL_PROGRESS_DELTA_PER_OUTCOME=0.05

# Analyzed evidence revises beliefs and reviews due predictions within local bounds.
NOYRA_MAX_EPISTEMIC_REVIEW_MODEL_CALLS_PER_DAY=4
NOYRA_MAX_BELIEF_CONFIDENCE_DELTA=0.15

# Development exports contain private runtime state but exclude or redact credentials.
NOYRA_DEVELOPER_LOG_EXPORT_ENABLED=true

# Long-term recall and deterministic consolidation keep active context bounded.
NOYRA_MEMORY_CONSOLIDATION_INTERVAL_SECONDS=86400
NOYRA_MEMORY_STALE_AFTER_DAYS=30
NOYRA_MEMORY_ARCHIVE_AFTER_DAYS=180
NOYRA_MINIMUM_ACTIVE_MEMORIES=24
NOYRA_MEMORY_INTEGRATION_INTERVAL_SECONDS=86400
NOYRA_MAX_MEMORY_INTEGRATION_CALLS_PER_DAY=2
NOYRA_MAX_MEMORY_INTEGRATION_CONTEXT_CHARS=32000

# Proactive social cognition reviews one known correspondent at a time.
NOYRA_SOCIAL_REVIEW_INTERVAL_SECONDS=21600
NOYRA_MAX_SOCIAL_MODEL_CALLS_PER_DAY=4
NOYRA_MAX_SOCIAL_CONTEXT_CHARS=32000

# The operational self-model is private and revised only from durable local evidence.
NOYRA_SELF_MODEL_REVIEW_INTERVAL_SECONDS=86400
NOYRA_MAX_SELF_MODEL_CALLS_PER_DAY=2
NOYRA_MAX_SELF_MODEL_CONTEXT_CHARS=48000

# Intrinsic attention runs only when durable internal tensions exist.
NOYRA_THOUGHT_INTERVAL_SECONDS=1800
NOYRA_MAX_THOUGHT_MODEL_CALLS_PER_DAY=8
NOYRA_MAX_THOUGHT_CONTEXT_CHARS=32000
NOYRA_MAX_THOUGHT_NO_CHANGE_STREAK=3
NOYRA_THOUGHT_COOLDOWN_SECONDS=21600
NOYRA_MAX_THOUGHT_GOALS_PER_DAY=1
NOYRA_METACOGNITIVE_SLEEP_THRESHOLD=0.82
NOYRA_METACOGNITIVE_SLEEP_SECONDS=3600
NOYRA_METACOGNITIVE_FIXATION_PENALTY=0.2
NOYRA_METACOGNITIVE_PENDING_TIMEOUT_SECONDS=1800
NOYRA_MOTIVATION_REVIEW_INTERVAL_SECONDS=172800
NOYRA_MAX_MOTIVATION_MODEL_CALLS_PER_DAY=1
NOYRA_MAX_MOTIVATION_CONTEXT_CHARS=56000
NOYRA_MAX_VALUE_WEIGHT_DELTA=0.15
NOYRA_MINIMUM_MISSION_VALUE_COUNT=2
NOYRA_MINIMUM_MISSION_SLEEP_COUNT=2
NOYRA_MINIMUM_MISSION_ADOPTION_SLEEP_COUNT=5

# Small autonomous projects turn active goals into bounded, inspectable multi-cycle work.
NOYRA_PROJECT_FORMATION_INTERVAL_SECONDS=86400
NOYRA_PROJECT_REVIEW_INTERVAL_SECONDS=7200
NOYRA_MAX_PROJECT_MODEL_CALLS_PER_DAY=4
NOYRA_MAX_PROJECT_CONTEXT_CHARS=48000
NOYRA_MAX_ACTIVE_PROJECTS=2
NOYRA_MAX_PROJECT_DURATION_HOURS=168
NOYRA_MAX_PROJECT_PHASES=8
NOYRA_MAX_PROJECT_CYCLES=24
NOYRA_MAX_PROJECT_MODEL_CALLS=16
NOYRA_MAX_PROJECT_SEARCHES=12
NOYRA_MAX_PROJECT_EXTERNAL_ACTIONS=8
NOYRA_MAX_PROJECT_STORAGE_BYTES=2000000
NOYRA_MAX_PROJECT_NO_PROGRESS_REVIEWS=3

# scripts/env.ps1 uses project-local runtime paths on the chosen checkout volume.
# Development mode reports that at-rest protection is not enforced. Before using real private
# state, switch to required, place NOYRA_DATA_DIR on BitLocker/LUKS, and initialize a backup
# keyring outside that directory with `python -m noyra backup-key init --path <path>`.
NOYRA_AT_REST_MODE=development
NOYRA_VOLUME_ENCRYPTION_BACKEND=auto
NOYRA_VOLUME_ATTESTATION_PATH=
NOYRA_BACKUP_KEYRING_PATH=
# Docker Compose host bind sources; provision both before starting the container.
NOYRA_BACKUP_KEYRING_HOST_PATH=./.runtime/at-rest/backup-keyring.json
NOYRA_VOLUME_ATTESTATION_HOST_PATH=./.runtime/at-rest/volume-attestation.json
NOYRA_HOST=127.0.0.1
NOYRA_PORT=8765
NOYRA_SUBJECT_ID=Noyra-0001
NOYRA_GENESIS_HASH=
NOYRA_ADMIN_TOKEN=
NOYRA_READ_TOKEN=
NOYRA_OPERATOR_TOKEN=
NOYRA_EXPORT_TOKEN=
NOYRA_BREAK_GLASS_TOKEN=
NOYRA_ALLOW_INSECURE_NON_LOOPBACK=false
NOYRA_MAX_HTTP_THREADS=32
NOYRA_REQUEST_RATE_LIMIT_PER_MINUTE=120
NOYRA_TRUSTED_PROXY_CIDRS=
# Public-post abuse defaults; operator overrides are stored in the subject DB.
NOYRA_PUBLIC_POST_RATE_LIMIT_PER_HOUR=10
NOYRA_PUBLIC_POST_QUEUE_CAP=1000
NOYRA_PUBLIC_POST_CAPTCHA_TTL_SECONDS=300
NOYRA_PUBLIC_POST_CAPTCHA_MAX_ATTEMPTS=5
NOYRA_PUBLIC_POST_CAPTCHA_MODE=alphanumeric
NOYRA_PUBLIC_POST_STORAGE_CAP_BYTES=250000000
NOYRA_PUBLIC_POST_CAPTCHA_ISSUE_LIMIT_PER_HOUR=30
NOYRA_PUBLIC_POST_CAPTCHA_GLOBAL_RATE_PER_MINUTE=300
NOYRA_HEALTH_CACHE_TTL_SECONDS=5
NOYRA_ACTIVE_INTERVAL_SECONDS=30
NOYRA_SLEEP_INTERVAL_SECONDS=60
NOYRA_DEEP_SLEEP_SECONDS=21600
NOYRA_ERROR_BACKOFF_SECONDS=30
NOYRA_INTEGRITY_MODE=alert
NOYRA_INTEGRITY_INTERVAL_SECONDS=300
NOYRA_INTEGRITY_RETRY_SECONDS=60
NOYRA_INTEGRITY_STARTUP_DEADLINE_SECONDS=10
NOYRA_INTEGRITY_PERIODIC_DEADLINE_SECONDS=30
NOYRA_INTEGRITY_MAX_ROWS_PER_CHECK=20000
NOYRA_INTEGRITY_MAX_BYTES_PER_CHECK=64000000
NOYRA_INTEGRITY_MAX_VALUE_BYTES=16000000
NOYRA_INTEGRITY_MAX_FILES_PER_CHECK=50000
NOYRA_REQUEST_TIMEOUT_SECONDS=10
NOYRA_MAX_REQUEST_BYTES=100000

# Cross-platform storage and training provenance defaults.
NOYRA_TRAINING_RECORD_ENABLED=true
NOYRA_TRAINING_EXPORT_ENABLED=true
NOYRA_TRAINING_INCLUDE_PRIVATE_PSYCHOLOGY=false
NOYRA_TRAINING_INCLUDE_CONVERSATIONS=false
NOYRA_TRAINING_INCLUDE_MODEL_IO=false
NOYRA_TRAINING_INCLUDE_EXTERNAL_ACTIONS=true
NOYRA_TRAINING_INCLUDE_WORKSPACE=false
# Optional S3-compatible cold archive. Credentials use the standard AWS SDK
# environment/role chain and are never stored in Noyra's database.
NOYRA_ARCHIVE_S3_BUCKET=
NOYRA_ARCHIVE_S3_ENDPOINT=
NOYRA_ARCHIVE_S3_REGION=
NOYRA_ARCHIVE_S3_PREFIX=
NOYRA_ARCHIVE_S3_ATTEMPTS=3
NOYRA_ARCHIVE_S3_ACCOUNT_ID=
NOYRA_ARCHIVE_S3_CONNECT_TIMEOUT_SECONDS=5
NOYRA_ARCHIVE_S3_READ_TIMEOUT_SECONDS=20
NOYRA_ARCHIVE_S3_OPERATION_TIMEOUT_SECONDS=30
NOYRA_ARCHIVE_S3_READINESS_TTL_SECONDS=60
NOYRA_ARCHIVE_S3_CIRCUIT_FAILURES=3
NOYRA_ARCHIVE_S3_CIRCUIT_COOLDOWN_SECONDS=30
NOYRA_SUBJECT_STORAGE_QUOTA_BYTES=2000000000
NOYRA_TRAINING_STORAGE_QUOTA_BYTES=5000000000
NOYRA_WORKSPACE_STORAGE_QUOTA_BYTES=20000000000
NOYRA_MINIMUM_FREE_STORAGE_BYTES=500000000
NOYRA_EVENT_PAYLOAD_RETENTION_DAYS=90
NOYRA_ARCHIVE_ENCRYPTION_KEY=
