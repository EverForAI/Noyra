# Install as /etc/systemd/system/noyra.service.d/credentials.conf after
# creating the root-owned source files under /etc/noyra/credentials.
[Service]
LoadCredential=model-api-key:/etc/noyra/credentials/model-api-key
LoadCredential=embedding-api-key:/etc/noyra/credentials/embedding-api-key
LoadCredential=wallet-signer-token:/etc/noyra/credentials/wallet-signer-token
LoadCredential=economy-model-groups:/etc/noyra/credentials/economy-model-groups.json
LoadCredential=deep-model-groups:/etc/noyra/credentials/deep-model-groups.json
