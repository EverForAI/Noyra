[Unit]
Description=Noyra restricted migration target agent
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/noyra/migration/identity.json
RequiresMountsFor=/var/lib/noyra

[Service]
Type=simple
User=noyra
Group=noyra
WorkingDirectory=/opt/noyra/current
ExecStart=/opt/noyra/current/.venv/bin/python /opt/noyra/current/scripts/noyra-migration-agent.py --identity-file /etc/noyra/migration/identity.json --data-root /var/lib/noyra/migration-agent --listen 127.0.0.1:8876
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/noyra/migration-agent
ReadOnlyPaths=/etc/noyra/migration/identity.json
UMask=0077

[Install]
WantedBy=multi-user.target
