# Install as /etc/noyra/migration/agent.env, root:noyra mode 0640.
# Do not copy the general noyra.env file here: the agent has no need for admin,
# model, search, Cloudflare or cloud provisioning credentials.
NOYRA_MIGRATION_COST_MICROUSD_MONTH=0
NOYRA_MIGRATION_REGION=

# Only when using external signer rebinding, mirror the target runtime's
# signer settings and a private token FILE (not its value). LoadCredential
# deployments must provision the same credential on the agent unit as well.
NOYRA_WALLET_MODE=disabled
NOYRA_WALLET_SIGNER_ENDPOINT=
NOYRA_WALLET_SIGNER_ID=
NOYRA_WALLET_SIGNER_ADDRESS=
NOYRA_WALLET_SIGNER_BEARER_TOKEN_FILE=

# If cold archives are encrypted, provision the matching archive keyring
# through the existing archive configuration on both runtime and agent.
NOYRA_ARCHIVE_KEYRING_PATH=
